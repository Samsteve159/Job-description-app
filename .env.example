# Everything here runs on NVIDIA NIM's free tier. No paid provider is required.
#
# Get a key at build.nvidia.com. Free, email only, no card. It starts with "nvapi-".
NIM_API_KEY=

# Fallback only. Every primary route is free NIM; this fires just when one fails.
# It is a PAID call and is logged at WARNING with the word PAID when it happens.
ANTHROPIC_API_KEY=
LLM_FALLBACK=anthropic:claude-sonnet-5

# ---------------------------------------------------------------------- app
HOST=127.0.0.1
PORT=8100
AUTH_ENABLED=false
STRICT_NUMBERS=true
DRY_RUN=false

# ======================================================================
# OPTIONAL. Nothing below is needed to run the app. Left commented so the
# free path stays the default and the file stays honest about what it costs.
# ======================================================================

# Override the model for one stage, or all of them.
# Per-stage defaults live in config.py:
#   score / extract / screening / brief   deepseek-ai/deepseek-v4-flash
#   tailor                                deepseek-ai/deepseek-v4-pro   (thinking model)
#   cover                                 moonshotai/kimi-k2.6
# LLM_ROUTE_TAILOR=nim:moonshotai/kimi-k2.6
# NIM_MODEL=deepseek-ai/deepseek-v4-flash
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Fallback when a route fails. Defaults to nim:deepseek-ai/deepseek-v4-flash.
# Only set this to a paid provider if you decide the free models are not good enough.
# LLM_FALLBACK=nim:deepseek-ai/deepseek-v4-flash
# ANTHROPIC_API_KEY=

# Job APIs. Needed for Scout Finds only, not for the writer. Both have free tiers.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# RAPIDAPI_KEY=

# VM scout worker sync. Only if you build the always-on worker.
# WORKER_URL=
# WORKER_TOKEN=
